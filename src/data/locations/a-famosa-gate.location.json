  "plateProps": [
    {
      "key": "a-famosa-wall",
      "type": "fortress-wall",
      "x": -64,
      "y": 202,
      "label": "The wall of A Famosa",
      "examineText": "Laterite cut out of the hill it stands on, two fathoms thick at the base, raised by Albuquerque's men in five months out of the stones of the sultan's mosque and the tombs of his fathers. Nobody in Melaka has forgotten which stones.",
      "interactive": false
    },
