{
  "name": "a-famosa-streets-of-golden-melaka",
  "version": "0.10.0",
  "description": "A pixel-art adventure RPG set in Portuguese Melaka circa 1580",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "electron": "npm run build && electron .",
    "electron:dev": "electron . --dev",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder --mac --win --linux",
    "pretest": "node tools/validate-gameplay-assets.cjs && node tools/validate-location-data.cjs && node tools/forge/validate-canon.cjs && node tools/validate-style.cjs",
    "prebuild": "node tools/validate-gameplay-assets.cjs && node tools/validate-location-data.cjs && node tools/forge/validate-canon.cjs --fast",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:art": "node tools/validate-gameplay-assets.cjs",
    "validate:all": "node tools/validate-gameplay-assets.cjs && node tools/validate-location-data.cjs && node tools/forge/validate-canon.cjs && node tools/validate-style.cjs",
    "generate:character-sheets": "node tools/generate-character-sheets-v2.cjs",
    "generate:crowd": "node tools/generate-crowd-silhouettes.cjs",
    "generate:tiles": "node tools/ultima8-graphics/generate-all.cjs",
    "generate:iso-tiles": "node tools/generate-iso-tiles.cjs",
    "generate:particles": "node tools/generate-particle-sprites.cjs",
    "generate:ui": "node tools/generate-ui-assets.cjs",
    "forge:palette": "node tools/forge/palette.cjs --sheet --check",
    "forge:luts": "node tools/forge/relight.cjs --preview",
    "forge:relight": "node tools/forge/relight-plates.cjs",
    "forge:remap": "node tools/forge/remap-canon.cjs",
    "validate:canon": "node tools/forge/validate-canon.cjs",
    "generate:audio": "node tools/generate-audio/generate-all.cjs --analyze",
    "verify:audio": "node tools/generate-audio/verify-browser.cjs",
    "scenes:rederive": "node tools/rederive-scenes.cjs",
    "scenes:fix-sky": "node tools/fix-checkerboard-sky.cjs",
    "generate:screens": "node tools/generate-interim-screens.cjs",
    "generate:portraits": "node tools/forge/portraits/generate.cjs --write",
    "generate:animated-objects": "node tools/ultima8-graphics/animated-objects.cjs",
    "generate:all-art": "node tools/ultima8-graphics/generate-all.cjs && node tools/ultima8-graphics/animated-objects.cjs && node tools/generate-character-sheets-v2.cjs && node tools/generate-crowd-silhouettes.cjs && node tools/generate-iso-tiles.cjs && node tools/generate-particle-sprites.cjs && node tools/generate-ui-assets.cjs",
    "generate:graphics": "npm run generate:all-art && npm run forge:relight",
    "fix:assets": "node tools/fix-gameplay-assets.cjs",
    "validate:style": "node tools/validate-style.cjs",
    "sync:ultima8-refs": "node tools/sync-style-map.cjs",
    "wave:status": "node tools/wave-status.cjs",
    "grade:wave": "node tools/grade-wave-assets.cjs",
    "audit:art": "npm run validate:art -- --report docs/art-bible/art-audit-structural.md && npm run validate:style -- --report docs/art-bible/art-audit-style.md",
    "validate:locations": "node tools/validate-location-data.cjs"
  },
  "keywords": [
    "phaser",
    "react",
    "rpg",
    "pixel-art",
    "adventure",
    "melaka",
    "historical"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "framer-motion": "^10.16.0",
    "phaser": "^3.70.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "canvas": "^3.2.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "@electron/asar": {
      "minimatch": "3.1.4"
    },
    "@electron/universal": {
      "minimatch": "3.1.4"
    },
    "app-builder-lib": {
      "minimatch": "5.1.8"
    },
    "config-file-ts": {
      "glob": {
        "minimatch": "9.0.7"
      }
    },
    "dir-compare": {
      "minimatch": "3.1.4"
    },
    "filelist": {
      "minimatch": "5.1.8"
    },
    "glob": {
      "minimatch": "3.1.4"
    },
    "readdir-glob": {
      "minimatch": "5.1.8"
    },
    "test-exclude": {
      "minimatch": "3.1.4"
    }
  },
  "build": {
    "appId": "com.afamosa.melaka",
    "productName": "A Famosa Streets of Golden Melaka",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "dmg": {
      "title": "${productName}",
      "backgroundColor": "#0a0806"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
