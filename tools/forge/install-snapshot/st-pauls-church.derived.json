      "key": "terrace-wall",
      "type": "terrace-wall",
      "x": -64,
      "y": 158,
      "label": "The churchyard wall",
      "examineText": "You can see the whole roadstead from here: the quay, the river mouth, and every sail between the hill and Sumatra. It is the reason the fortress is where it is.",
      "interactive": false
    },
    {
      "key": "view-bench",
      "type": "bench",
      "x": 224,
      "y": 186,
      "label": "A bench on the crest",
      "examineText": "A worn bench under the arcade.",
      "interactive": false
    },
    {
      "key": "grave-em-terra",
      "type": "gravestone",
      "x": 0,
      "y": 206,
      "label": "A headstone",
      "examineText": "EM TERRA ESTRANHA — in a strange land. Below it a date, 1547, and a name the lichen has taken.",
      "interactive": false
    },
    {
      "key": "st-pauls",
      "type": "church",
      "x": 384,
      "y": 188,
      "label": "The church on the hill",
      "examineText": "Nossa Senhora da Anunciada, raised in 1521 by a captain who had promised it in a storm. The nave is four times a man's height and the bell can be heard at the kampung. Padre Tomas says the Jesuits keep it swept; he does not say who pays for the candles.",
      "interactive": false
    },
    {
      "key": "lantern-post-29",
      "type": "lantern-post",
      "x": 582,
      "y": 225,
      "label": "lantern post",
      "examineText": "A pitch lantern on an iron bracket.",
      "interactive": false
    },
    {
      "key": "ledger-slab",
      "type": "tomb-slab",
      "x": 48,
      "y": 224,
      "label": "A ledger slab",
      "examineText": "A Portuguese name, and cut straight across it a Dutch one. The stone was too good to waste on only one family.",
      "interactive": false
    },
    {
      "key": "sailors-cross",
      "type": "stone-cross",
      "x": 128,
      "y": 242,
      "label": "The sailors' cross",
      "examineText": "Set up for the men the strait kept. There are no names on it — there were too many, and most of them were not written down anywhere to begin with.",
      "interactive": false
    },
    {
      "key": "porch-brazier",
      "type": "brazier",
      "x": 477,
      "y": 245,
      "label": "A brazier by the porch",
      "examineText": "A charcoal brazier; skewers of grilled fish sputter over it.",
      "interactive": false
    },
    {
      "key": "hill-padrao",
      "type": "padrao",
      "x": 339,
      "y": 255,
      "label": "The padrão",
      "examineText": "A stone pillar cut with the Cross of the Order of Christ, set on the highest point of the town so that it is the first thing a ship sees and the last thing it loses.",
      "interactive": false
    },
    {
      "key": "lantern-post-28",
      "type": "lantern-post",
      "x": 234,
      "y": 269,
      "label": "lantern post",
      "examineText": "A pitch lantern on an iron bracket.",
      "interactive": false
    },
    {
